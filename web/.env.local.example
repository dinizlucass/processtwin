OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelo do assistente de processos (se vazio, usa OPENAI_MODEL)
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
# Chave compartilhada obrigatória para liberar o piloto; substitua por autenticação por usuário em produção
PROCESS_ASSISTANT_ACCESS_KEY=
# Opcional: all inclui rascunhos/em revisão (o padrão é somente publicado)
PROCESS_ASSISTANT_SCOPE=published
# Extração de documentos, entrevista com transcrição, geração e revisão do mapa
OPENAI_MAPPING_MODEL=gpt-5.4-mini
# modelo de transcrição de voz (padrão: whisper-1)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Project Settings > Data API no painel do Supabase
SUPABASE_URL=
# Project Settings > API Keys > service_role (secret — nunca exponha no client)
SUPABASE_SERVICE_ROLE_KEY=
